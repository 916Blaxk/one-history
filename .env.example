# Frontend URL for the Socket.IO server (complete URL, including protocol).
VITE_SERVER_URL=http://localhost:3001

# Optional. Origin of the One History character sheet site (no trailing slash).
# When empty, the sheet integration stays hidden.
# VITE_FICHAS_URL=http://localhost:3457

# Node server settings. ALLOWED_ORIGINS is a comma-separated list of frontend origins.
PORT=3001
ALLOWED_ORIGINS=http://localhost:5173
