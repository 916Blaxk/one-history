# Copie para .env só se precisar mudar o padrão.

# Onde ficam os dados. O padrão é um arquivo local.
# DATABASE_URL=file:dados/one-history.db

# Para hospedagens sem disco permanente (como a Vercel), use um banco Turso:
# DATABASE_URL=libsql://seu-banco.turso.io
# DATABASE_AUTH_TOKEN=

# Sites do Tablebola que podem embutir a ficha e chamar /api/integracao.
# Origens exatas, separadas por vírgula, sem barra final e sem curinga.
# Só aceita https, ou http em localhost e 127.0.0.1. Vazio: nenhum site é aceito.
# ORIGENS_TABLEBOLA=https://table-bola.vercel.app,http://localhost:5173
