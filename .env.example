# Copie para .env só se precisar mudar o padrão.

# Onde ficam os dados. O padrão é um arquivo local.
# DATABASE_URL=file:dados/one-history.db

# Para hospedagens sem disco permanente (como a Vercel), use um banco Turso:
# DATABASE_URL=libsql://seu-banco.turso.io
# DATABASE_AUTH_TOKEN=

# Porta do servidor único (site e mesa). A hospedagem costuma definir sozinha.
# PORT=3000
