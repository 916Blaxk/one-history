{
  "name": "one-history",
  "version": "2.0.0",
  "private": true,
  "description": "Fichas e campanhas do sistema de RPG One History",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "db:gerar": "drizzle-kit generate",
    "db:migrar": "node scripts/migrar.mjs",
    "predev": "npm run db:migrar",
    "dev": "node --import tsx servidor.ts --dev",
    "build": "npm run db:migrar && next build",
    "prestart": "npm run db:migrar",
    "start": "node --import tsx servidor.ts",
    "senha": "node scripts/redefinir-senha.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint ."
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.69.0",
    "next": "^16.4.5",
    "pixi.js": "^8.22.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "sonner": "^2.0.8",
    "swr": "^2.5.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "typescript": "5.9",
    "vitest": "^3.2.7"
  }
}
